# Firebase web app configuration (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_ADDRESS=localhost

# Runtime options
SIZVO_TEMP_DIR=/tmp/sizvo
SIZVO_JOB_TTL_MINUTES=30
SIZVO_MAX_FILE_MB=50
SIZVO_MAX_FILES=20
SIZVO_MAX_VIDEO_MB=500
SIZVO_MAX_VIDEOS=5
SIZVO_MAX_VIDEO_MINUTES=30
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Backward-compatible fallback: COMPRESSLY_* variables are also supported.
